# Shared configuration. Copy to .env and fill in; never commit .env.
# Each service additionally reads apps/<service>/.env for its own ports.

NODE_ENV=development

# MySQL — consumed by the compose file and by libs/common DatabaseModule.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=reservations
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=
# TypeORM schema synchronisation. Must be the literal string 'true' to take
# effect, and is refused entirely when NODE_ENV=production.
MYSQL_SYNCHRONIZE=false

# auth service
HTTP_PORT=3001
TCP_PORT=3002
JWT_SECRET=
JWT_EXPIRATION=3600

# reservations service
PORT=3000
AUTH_HOST=auth
AUTH_PORT=3002
PAYMENTS_HOST=payments
PAYMENTS_PORT=3003

# payments service
STRIPE_SECRET_KEY=
NOTIFICATION_HOST=notifications
NOTIFICATION_PORT=3004

# notifications service
SMTP_USER=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
