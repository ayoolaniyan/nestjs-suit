# Shared configuration for local development. Copy to .env and fill in; never
# commit .env. Each service also reads apps/<service>/.env for its own port
# (see the .env.example next to each one).
#
# Ports: reservations 3000 (HTTP) + 3005 (TCP), auth 3001 (HTTP) + 3002 (TCP),
#        payments 3006 (HTTP) + 3003 (TCP), notifications 3004 (HTTP).

NODE_ENV=development

# OpenAPI docs at /auth/docs and /reservations/docs. Defaults to on outside
# production and off in it.
# SWAGGER_ENABLED=true

# MySQL. The mysql container creates MYSQL_USER with access to MYSQL_DATABASE
# only; the services connect as that user, never as root.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=reservations
MYSQL_USER=app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# RabbitMQ, which carries notification emails. Without credentials in the
# URL the default guest account is used, which docker-compose opens to the
# other containers; anywhere else, use amqps://<user>:<password>@<host>.
RABBITMQ_URL=amqp://rabbitmq:5672

# auth and reservations (the public HTTP services)
# Browser origins allowed to call the API with cookies, comma-separated.
# CORS_ORIGINS=http://localhost:5173
# Set to 1 behind a load balancer, so rate limits see the client address.
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=120

# auth. Access tokens are short-lived; the refresh token (a session) renews
# them and can be revoked.
JWT_SECRET=
JWT_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION=2592000
LOGIN_ATTEMPTS_PER_15_MIN=10
# HTTPS-only cookies; defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# Where the services find each other.
AUTH_HOST=auth
AUTH_PORT=3002
PAYMENTS_HOST=payments
PAYMENTS_PORT=3003
RESERVATIONS_HOST=reservations
RESERVATIONS_PORT=3005

# payments. The webhook secret is printed by `stripe listen` locally, or
# shown on the endpoint's page in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# notifications. smtp for any SMTP server (Mailpit locally, Amazon SES in
# production) or gmail for Gmail with OAuth2.
MAIL_TRANSPORT=smtp
MAIL_FROM=bookings@example.com
MAIL_MAX_ATTEMPTS=5
SMTP_HOST=mailpit
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# For MAIL_TRANSPORT=gmail (SMTP_USER is the Gmail account):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
