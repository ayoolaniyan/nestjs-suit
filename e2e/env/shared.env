# Throwaway values for the e2e stack only. Nothing here is a real credential:
# the database and broker live and die with the compose run, Stripe is never
# reached (the key is fake, and the specs sign webhooks themselves), and email
# goes to Mailpit.
NODE_ENV=production
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=reservations
MYSQL_USER=app
MYSQL_PASSWORD=e2e-app-password
MYSQL_ROOT_PASSWORD=e2e-root-password
# No credentials in the URL: the client then uses RabbitMQ's default guest
# account (see docker/rabbitmq).
RABBITMQ_URL=amqp://rabbitmq:5672
JWT_SECRET=e2e-jwt-secret
JWT_EXPIRATION=3600
# The suite makes far more requests from one address than a person would;
# the login limit keeps its real value, and a spec checks it.
RATE_LIMIT_PER_MINUTE=10000
AUTH_HOST=auth
AUTH_PORT=3002
PAYMENTS_HOST=payments
PAYMENTS_PORT=3003
RESERVATIONS_HOST=reservations
RESERVATIONS_PORT=3005
STRIPE_SECRET_KEY=sk_test_e2e_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_e2e_not_a_real_secret
MAIL_TRANSPORT=smtp
MAIL_FROM=bookings@example.com
SMTP_HOST=mailpit
SMTP_PORT=1025
