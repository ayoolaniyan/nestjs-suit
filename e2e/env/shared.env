# Throwaway values for the e2e stack only. Nothing here is a real credential:
# the database lives and dies with the compose run, and Stripe and Gmail are
# never called by the suite.
NODE_ENV=production
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=reservations
MYSQL_USER=app
MYSQL_PASSWORD=e2e-app-password
MYSQL_ROOT_PASSWORD=e2e-root-password
JWT_SECRET=e2e-jwt-secret
JWT_EXPIRATION=3600
AUTH_HOST=auth
AUTH_PORT=3002
PAYMENTS_HOST=payments
PAYMENTS_PORT=3003
NOTIFICATION_HOST=notifications
NOTIFICATION_PORT=3004
STRIPE_SECRET_KEY=sk_test_e2e_not_a_real_key
SMTP_USER=e2e@example.com
GOOGLE_OAUTH_CLIENT_ID=e2e
GOOGLE_OAUTH_CLIENT_SECRET=e2e
GOOGLE_OAUTH_REFRESH_TOKEN=e2e
